# Policy Engine Runtime Image
# Generated by Policy Engine Builder
# Build Time: 2025-12-05T09:42:53Z

FROM alpine:3.22.2

# Add ca-certificates for HTTPS
RUN apk --no-cache add ca-certificates

WORKDIR /app

# Create non-root user
RUN addgroup -g 1000 policyengine && \
    adduser -D -u 1000 -G policyengine policyengine

# Copy the compiled binary
COPY policy-engine /app/policy-engine
RUN chmod +x /app/policy-engine

# Set ownership
RUN chown -R policyengine:policyengine /app/policy-engine

# Switch to non-root user
USER policyengine

# Expose default ports
EXPOSE 9001 9002

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/app/policy-engine", "--health-check"]

# Set entry point
# Run the binary
ENTRYPOINT ["/app/policy-engine"]
CMD ["-config=/configs/config.yaml"]

